# Copia este fichero como .env (junto a docker-compose.yml) y rellena los valores.
# El .env no se sube a git ni entra en la imagen Docker.
# La base de datos NO se configura aquí: es la de MONGODB_URI en next.config.js.

# Prefijo bajo el que se sirve la aplicación (debe coincidir con el location de nginx).
# Se fija al construir la imagen: si lo cambias, vuelve a hacer "docker compose build".
BASE_PATH=/aiquiz

# Clave para firmar las sesiones del manager. Obligatoria: sin ella no se puede iniciar sesión.
# Genera una larga y aleatoria, por ejemplo con: openssl rand -hex 32
JWT_SECRET=

# Opcional: clave de AssemblyAI para transcribir los vídeos que se suben a los subtemas.
ASSEMBLYAI_API_KEY=

# --- Creación de usuarios (npm run seed:admin) ---

# Super administrador (rol "admin"). Si ya existe un usuario con ese email, no se modifica.
SUPER_ADMIN_EMAIL=admin@upm.es
SUPER_ADMIN_PASSWORD=cambia-esta-contraseña
SUPER_ADMIN_NAME=Administrador
SUPER_ADMIN_FACULTY=ETSIT
SUPER_ADMIN_DEPARTMENT=DIT

# Profesor inicial (rol "professor"). Opcional: si dejas DEFAULT_PROFESSOR_EMAIL vacío no se crea.
# Si lo rellenas, el resto de campos son obligatorios. Si ya existe ese email, no se modifica.
DEFAULT_PROFESSOR_EMAIL=
DEFAULT_PROFESSOR_PASSWORD=
DEFAULT_PROFESSOR_NAME=
DEFAULT_PROFESSOR_FACULTY=
DEFAULT_PROFESSOR_DEPARTMENT=
